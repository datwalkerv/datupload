# --- Telegram (server-side only) -------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Private channel the bot is an admin of, e.g. -1001234567890.
TELEGRAM_CHANNEL_ID=
# Optional: point at a self-hosted Bot API server instead of api.telegram.org.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- API authentication ----------------------------------------------------
# Clients send `Authorization: Bearer <STORAGE_API_KEY>`. At least 16 characters.
# Generate one with: openssl rand -base64 32
STORAGE_API_KEY=
# Optional: HMAC secret for signed download URLs. Defaults to STORAGE_API_KEY.
URL_SIGNING_SECRET=

# --- MongoDB (file catalog) ------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=telegram-storage

# --- Vercel Blob (temporary staging for uploads over 4 MB) -----------------
# Set automatically by `vercel env pull` after connecting a Blob store.
# Without it, only direct uploads up to DIRECT_UPLOAD_MAX_MB are possible.
BLOB_READ_WRITE_TOKEN=
# Vercel Cron sends this as a Bearer token to /api/admin/cleanup.
CRON_SECRET=

# --- Limits ----------------------------------------------------------------
MAX_FILE_SIZE_MB=2000
# Size of each Telegram part. Capped at 19 (the Bot API can't download files over 20 MB).
CHUNK_SIZE_MB=19
# Largest file accepted by POST /api/files (Vercel's request body limit is 4.5 MB).
DIRECT_UPLOAD_MAX_MB=4
# Seconds browsers and the CDN cache public files (/api/public/...). Making a file private
# or deleting it can take this long to stop it being served from caches.
PUBLIC_CACHE_MAX_AGE=86400
RATE_LIMIT_UPLOADS_PER_MIN=20
RATE_LIMIT_REQUESTS_PER_MIN=300
# Comma-separated, without dots. Empty = no restriction.
ALLOWED_EXTENSIONS=
BLOCKED_EXTENSIONS=
